# Backend Gateway (Go Process)
PORT=20130
DATA_DIR=
BASE_URL=http://localhost:20130

# Frontend Next.js Dashboard
# PORT=20129
# NEXT_PUBLIC_BASE_URL=http://localhost:20129
# BACKEND_URL=http://127.0.0.1:20130

# Auth / keys
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
REQUIRE_API_KEY=false
AUTH_COOKIE_SECURE=false
TRUST_PROXY=false
SHUTDOWN_SECRET=

# OAuth Client Secrets (Optional override for OAuth client credentials)
ANTIGRAVITY_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_SECRET=

# Timeouts (ms)
STREAM_STALL_TIMEOUT_MS=360000
STREAM_FIRST_CHUNK_TIMEOUT_MS=200000
FETCH_CONNECT_TIMEOUT_MS=60000
VIDEO_FETCH_TIMEOUT_MS=120000

# Optional services
SEARXNG_URL=http://localhost:8888/search
HEADROOM_URL=http://localhost:8787
